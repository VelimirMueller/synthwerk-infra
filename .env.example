# Synthwerk local stack. Copy with scripts/init-env.sh: it writes .env and
# fills every empty *_PASSWORD, *_SECRET and *_MASTERKEY with a random dev-only
# value. Run it again after a pull: it appends new keys. Never commit .env.
# Names follow SYNTHWERK_<SERVICE>_<NAME> (D-40). OpenTelemetry uses the standard
# OTEL_* names without a prefix; compose sets them per service (x-service-env).

# Environment name: local | ci | dev | stg | prd.
SYNTHWERK_PLATFORM_ENV=local

# Edge (Traefik). Host port, bound to 127.0.0.1.
SYNTHWERK_EDGE_HTTP_PORT=8080

# WAF (Coraza + OWASP CRS v4). Engine: On (block) or DetectionOnly (log only).
SYNTHWERK_WAF_ENGINE=On
SYNTHWERK_WAF_PARANOIA_LEVEL=1

# Bus (NATS JetStream). Not published on the host.
SYNTHWERK_NATS_USER=synthwerk
SYNTHWERK_NATS_PASSWORD=

# Database (PostgreSQL). Not published on the host.
SYNTHWERK_POSTGRES_USER=synthwerk
SYNTHWERK_POSTGRES_PASSWORD=
SYNTHWERK_POSTGRES_DB=synthwerk

# Service database roles (compose/database/init.sql). Each role owns one schema
# in SYNTHWERK_POSTGRES_DB; zitadel owns its own database. The passwords go into
# postgres:// URLs unencoded: use only letters and digits (init-env.sh writes hex).
SYNTHWERK_IDENTITY_DB_PASSWORD=
SYNTHWERK_LLM_DB_PASSWORD=
SYNTHWERK_ZITADEL_DB_PASSWORD=

# Zitadel (D-42). Masterkey: exactly 32 characters, encrypts secrets in the DB;
# a new key needs a new instance. Domain, port and URL must match the public URL,
# else Zitadel answers "Instance not found". Locally: http://auth.localhost:8080.
# Dev VPS: synthwerkauth.velimir-mueller.de, port 443, secure true, scheme https.
SYNTHWERK_ZITADEL_MASTERKEY=
SYNTHWERK_ZITADEL_LOGIN_COOKIE_SECRET=
# First human admin (user zitadel-admin in org synthwerk). Used only at instance creation.
SYNTHWERK_ZITADEL_ADMIN_PASSWORD=
SYNTHWERK_ZITADEL_EXTERNAL_DOMAIN=auth.localhost
SYNTHWERK_ZITADEL_EXTERNAL_PORT=8080
SYNTHWERK_ZITADEL_EXTERNAL_SECURE=false
SYNTHWERK_ZITADEL_PUBLIC_SCHEME=http
SYNTHWERK_ZITADEL_PUBLIC_URL=http://auth.localhost:8080
# zitadel-bootstrap (zitadel/bootstrap). Test users operator.test and member.demo
# exist only when this is set: local and ci. Leave it out on dev and prd.
# Their password is this value plus "Aa1!" (complexity policy), like the admin.
SYNTHWERK_ZITADEL_TEST_USER_PASSWORD=
# Studio OIDC app: exact URIs, comma list. http URIs turn on Zitadel dev mode.
SYNTHWERK_ZITADEL_STUDIO_REDIRECT_URIS=http://localhost:3000/api/auth/callback
SYNTHWERK_ZITADEL_STUDIO_LOGOUT_URIS=http://localhost:3000/
SYNTHWERK_ZITADEL_ACCESS_TOKEN_LIFETIME=300s

# Mail (D-49). Local and ci: Mailpit, UI and API on http://127.0.0.1:8025.
# Dev and prd: set SYNTHWERK_ZITADEL_SMTP_HOST= (empty) so the bootstrap leaves the provider alone.
SYNTHWERK_ZITADEL_SMTP_HOST=mailpit:1025
SYNTHWERK_ZITADEL_SMTP_SENDER=auth@synthwerk.localhost
SYNTHWERK_MAILPIT_UI_PORT=8025

# Browser origins allowed to call /identity and /llm on the edge (comma list).
SYNTHWERK_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Telemetry (grafana/otel-lgtm). Host ports, bound to 127.0.0.1.
SYNTHWERK_TELEMETRY_UI_PORT=3000
SYNTHWERK_TELEMETRY_OTLP_GRPC_PORT=4317
SYNTHWERK_TELEMETRY_OTLP_HTTP_PORT=4318
