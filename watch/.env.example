# Copy to /opt/gatus/.env (mode 600) on synthwerk-watch. Generate each value:
#   head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40
# After a change: docker compose up -d --force-recreate gatus (restart keeps the old env).
DEV_HOST_IP=<dev host IPv4>
NTFY_TOPIC=synthwerk-<random>
HB_TOKEN_HOST=<random>
HB_TOKEN_VISION=<random>
